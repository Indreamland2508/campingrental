@{
    ViewData["Title"] = "Backup & Restore Dữ liệu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .backup-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        color: white;
        padding: 40px;
        margin-bottom: 40px;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.2);
    }

    .backup-action-card {
        border: 2px solid #f0f0f0;
        border-radius: 16px;
        padding: 32px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .backup-action-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
    }

    .backup-action-card:hover {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border-color: #667eea;
    }

    .action-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
        margin-bottom: 20px;
    }

    .backup-info-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 16px;
        padding: 12px;
        background: #f8f9ff;
        border-radius: 8px;
        border-left: 4px solid #667eea;
    }

    .backup-info-item i {
        color: #667eea;
        margin-right: 12px;
        margin-top: 2px;
        font-size: 18px;
    }

    .file-upload-zone {
        border: 2px dashed #667eea;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        background: #f8f9ff;
        transition: all 0.3s ease;
    }

    .file-upload-zone:hover {
        background: #f0f2ff;
        border-color: #764ba2;
    }

    .btn-backup-export {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 12px 28px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-backup-export:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }

    .btn-backup-restore {
        background: #ff6b6b;
        border: none;
        color: white;
        padding: 12px 28px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-backup-restore:hover {
        color: white;
        background: #ff5252;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 107, 0.3);
    }

    .warning-badge {
        display: inline-block;
        background: #fff3cd;
        color: #856404;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="backup-header">
        <div class="d-flex align-items-center">
            <div>
                <h1 class="fw-bold mb-2 display-6">
                    <i class="bi bi-cloud-download me-3"></i>Backup & Restore
                </h1>
                <p class="mb-0 opacity-90" style="font-size: 16px;">
                    Quản lý sao lưu và khôi phục dữ liệu hệ thống một cách an toàn
                </p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Thành công!</strong> @ViewBag.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Lỗi!</strong> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 mb-5">
        <!-- Sao lưu dữ liệu -->
        <div class="col-lg-6">
            <div class="backup-action-card shadow-sm">
                <div class="action-icon">
                    <i class="bi bi-cloud-upload"></i>
                </div>
                <h4 class="fw-bold mb-2">Sao lưu dữ liệu</h4>
                <p class="text-muted mb-4" style="font-size: 14px;">
                    Tạo bản sao lưu toàn bộ dữ liệu hệ thống dưới dạng file JSON
                </p>

                <div class="backup-info-item">
                    <i class="bi bi-check-circle"></i>
                    <div>
                        <strong style="font-size: 13px;">Bao gồm:</strong>
                        <p class="mb-0" style="font-size: 12px; color: #666;">Danh mục, sản phẩm, gói combo, đơn hàng</p>
                    </div>
                </div>

                <div class="backup-info-item">
                    <i class="bi bi-lightning-charge"></i>
                    <div>
                        <strong style="font-size: 13px;">Nhanh & An toàn:</strong>
                        <p class="mb-0" style="font-size: 12px; color: #666;">Không ảnh hưởng đến dữ liệu hiện tại</p>
                    </div>
                </div>

                <a asp-controller="Admin" asp-action="ExportBackup" class="btn btn-backup-export w-100 mt-3">
                    <i class="bi bi-download me-2"></i> Tải File Backup Ngay
                </a>
            </div>
        </div>

        <!-- Khôi phục dữ liệu -->
        <div class="col-lg-6">
            <div class="backup-action-card shadow-sm">
                <div class="action-icon" style="background: linear-gradient(135deg, #ff6b6b 0%, #ff5252 100%);">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </div>
                <h4 class="fw-bold mb-2">Khôi phục dữ liệu</h4>
                <p class="text-muted mb-4" style="font-size: 14px;">
                    Phục hồi dữ liệu từ file backup JSON được tải lên
                </p>

                <div class="warning-badge">
                    <i class="bi bi-exclamation-triangle me-1"></i> Hành động này không thể hoàn tác
                </div>

                <form asp-controller="Admin" asp-action="RestoreBackup" method="post" enctype="multipart/form-data">
                    <div class="file-upload-zone mb-3">
                        <input type="file" name="backupFile" class="form-control d-none" id="backupFileInput" accept="application/json" required />
                        <label for="backupFileInput" style="cursor: pointer;">
                            <i class="bi bi-cloud-arrow-up" style="font-size: 32px; color: #667eea;"></i>
                            <p class="mt-2 mb-0">
                                <strong>Chọn file backup (.json)</strong>
                            </p>
                            <small class="text-muted">hoặc kéo thả vào đây</small>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-backup-restore w-100">
                        <i class="bi bi-upload me-2"></i> Khôi Phục Dữ Liệu
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Hướng dẫn & Lưu ý -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-info-circle-fill text-info me-2"></i>Hướng dẫn sử dụng
                </h5>
                <ol style="font-size: 14px; line-height: 1.8;">
                    <li class="mb-2">Bấm <strong>"Tải File Backup Ngay"</strong> để tạo bản sao lưu</li>
                    <li class="mb-2">File sẽ được lưu dưới dạng <code>.json</code> trên máy tính</li>
                    <li class="mb-2">Để khôi phục, chọn file backup và bấm nút khôi phục</li>
                    <li>Quá trình khôi phục sẽ mất vài giây tùy theo kích thước dữ liệu</li>
                </ol>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4" style="background: #fff5f5;">
                <h5 class="fw-bold mb-3 text-danger">
                    <i class="bi bi-exclamation-lg me-2"></i>Điều cần lưu ý
                </h5>
                <ul style="font-size: 14px; line-height: 1.8; margin-bottom: 0;">
                    <li class="mb-2"><strong>Restore xóa dữ liệu:</strong> Tất cả dữ liệu hiện tại sẽ bị xóa trước khi khôi phục</li>
                    <li class="mb-2"><strong>Không bao gồm settings:</strong> Cấu hình hệ thống được giữ nguyên</li>
                    <li><strong>File hợp lệ:</strong> Chỉ chọn file .json do hệ thống này tạo</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    // Drag and drop functionality
    const fileUploadZone = document.querySelector('.file-upload-zone');
    const fileInput = document.getElementById('backupFileInput');

    if (fileUploadZone && fileInput) {
        fileUploadZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            fileUploadZone.style.background = '#f0f2ff';
            fileUploadZone.style.borderColor = '#764ba2';
        });

        fileUploadZone.addEventListener('dragleave', (e) => {
            fileUploadZone.style.background = '#f8f9ff';
            fileUploadZone.style.borderColor = '#667eea';
        });

        fileUploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            fileUploadZone.style.background = '#f8f9ff';
            fileUploadZone.style.borderColor = '#667eea';
            fileInput.files = e.dataTransfer.files;
        });
    }
</script>
